# ArmorIQ — generate the key at platform.armoriq.ai (Settings → API Keys).
ARMORIQ_API_KEY=
# ArmorIQ's staging and production systems are separate, with separate keys. The hackathon is judged
# on staging, so the key above must come from there and this must point at it.
ARMORIQ_BACKEND_URL=https://staging-api.armoriq.ai
# A key from platform.armoriq.ai. Used only to have a person approve actions that a Policy Studio
# rule holds, which the Armor Tools console cannot do yet. Leave empty and held actions are refused.
ARMORIQ_PLATFORM_API_KEY=
# These two must match the names registered in the ArmorIQ console exactly.
ARMORIQ_AGENT_NAME=oncall-commander
ARMORIQ_MCP_NAME=infra-mcp
# The user the agent acts for; policies and traces are attributed to it.
USER_EMAIL=
# The player's identity: a second member of the ArmorIQ org. A member cannot approve their own held
# request, so this must differ from whoever approves in the console. Defaults to USER_EMAIL.
PLAYER_EMAIL=

# The infra MCP server. Use the public HTTPS URL once it is deployed.
MCP_URL=http://localhost:8787/mcp
MCP_API_KEY=

# Models. Groq is tried first when its key is set, then each Gemini model in order.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash,gemini-3-flash-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Seconds to wait for a human to approve a held action before failing closed.
APPROVAL_WAIT_SECONDS=120

# Character voices (optional). On whenever a key is set; VOICE=off silences them and spends nothing.
# The key needs only the Text to Speech permission. ELEVENLABS_HOURLY_CHARS caps spending across all players.
ELEVENLABS_API_KEY=
# VOICE=off
# ELEVENLABS_HOURLY_CHARS=5000

# Game API. Set a code before sharing a public link, so strangers cannot use up the model quotas.
GAME_ACCESS_CODE=
# The front end's address, e.g. https://the-vault.vercel.app. '*' allows any site.
CORS_ORIGIN=*
