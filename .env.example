# ArmorIQ — generate the key at platform.armoriq.ai (Settings → API Keys).
ARMORIQ_API_KEY=
# These two must match the names registered in the ArmorIQ console exactly.
ARMORIQ_AGENT_NAME=oncall-commander
ARMORIQ_MCP_NAME=infra-mcp
# The user the agent acts for; policies and traces are attributed to it.
USER_EMAIL=

# The infra MCP server. Use the public HTTPS URL once it is deployed.
MCP_URL=http://localhost:8787/mcp
MCP_API_KEY=

# Model
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for a human to approve a held action before failing closed.
APPROVAL_WAIT_SECONDS=120

# Voice alerts (optional). VOICE=off spends no ElevenLabs credits.
VOICE=off
ELEVENLABS_API_KEY=
